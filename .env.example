# Server Port (Render sets this dynamically, default 3000)
PORT=3000

# Environment mode
NODE_ENV=development

# Groq API Key for LLaMA 3.3 70B & 8B inference
# Obtain your free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional Gemini API Key
GEMINI_API_KEY=

# Optional external backend URL for frontend if hosted separately from backend
# (e.g. https://your-cbmu-backend.onrender.com)
VITE_BACKEND_URL=
