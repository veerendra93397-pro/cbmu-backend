# Server Port (Render sets this dynamically, default 3000)
PORT=3000

# Environment mode
NODE_ENV=development

# Groq API Key for LLaMA 3.3 70B & 8B inference
# Obtain your free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional Gemini API Key
GEMINI_API_KEY=

# External backend URL for frontend pointing directly to CBMU-BACKEND on Render
VITE_BACKEND_URL=https://cbmu-backend.onrender.com

# Admin Authentication Password on Render Connect
ADMIN_PASSWORD=cbmuadmin
